{
  "version": 1,
  "manager": "npm",
  "tsconfigs": ["tsconfig.app.json", "tsconfig.node.json"],
  "gates": [
    {
      "name": "lint",
      "command": ["npm", "run", "lint"]
    },
    {
      "name": "types",
      "command": [
        "node",
        "scripts/maintenance/typecheck.mjs",
        "tsconfig.app.json",
        "tsconfig.node.json"
      ]
    },
    {
      "name": "test",
      "command": ["node", "node_modules/vitest/vitest.mjs", "run", "--maxWorkers=1"]
    },
    {
      "name": "build",
      "command": ["npm", "run", "build"],
      "env": {
        "VITE_SUPABASE_URL": "https://maintenance.invalid",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_maintenance_test",
        "VITE_SUPABASE_ANON_KEY": "maintenance_test"
      }
    }
  ],
  "fix": {
    "roots": ["src"],
    "eslintRules": [],
    "prettier": true,
    "exclude": ["src/integrations/supabase/types.ts"]
  },
  "timeoutMs": 300000,
  "maxFiles": 20,
  "maxChangedLines": 400
}
