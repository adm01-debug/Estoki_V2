# ─── Supabase (obrigatório) ───────────────────────────────────────────────
# Apenas chaves publicáveis/anon. NUNCA coloque service_role aqui.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ─── Aplicação ────────────────────────────────────────────────────────────
VITE_APP_ENV="development"        # development | staging | production
VITE_APP_VERSION="0.0.0-dev"
VITE_APP_URL="http://localhost:8080"
VITE_API_URL=""                    # opcional: base de API externa

# ─── Feature flags ────────────────────────────────────────────────────────
VITE_ENABLE_PWA="false"
VITE_ENABLE_OFFLINE_MODE="true"
VITE_ENABLE_GAMIFICATION="true"

# ─── Observabilidade (opcional) ───────────────────────────────────────────
VITE_SENTRY_DSN=""
VITE_GA_ID=""
VITE_GA_TRACKING_ID=""

# ─── Push notifications (opcional) ────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=""

# ─── Integrações opcionais ────────────────────────────────────────────────
VITE_CORREIOS_API_KEY=""
VITE_NFE_CERTIFICATE_PATH=""
VITE_BITRIX=""

# ─── Segredos de servidor ─────────────────────────────────────────────────
# CORREIOS_USER, CORREIOS_TOKEN, RESEND_API_KEY, METRICS_TOKEN, WEBHOOK_SECRET
# e SUPABASE_SERVICE_ROLE_KEY vivem APENAS nos secrets das Edge Functions.
