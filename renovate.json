{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "automerge": true },
    { "matchDepTypes": ["devDependencies"], "automerge": true },
    { "matchPackagePatterns": ["eslint", "prettier"], "groupName": "linters" },
    { "matchPackagePatterns": ["@types/*"], "groupName": "types" },
    { "matchPackagePatterns": ["vitest", "@testing-library/*"], "groupName": "testing" }
  ]
}
